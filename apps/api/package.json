{
  "name": "@smartthink/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "migrate:up": "node --env-file-if-exists=../../.env scripts/migrate.mjs up",
    "migrate:down": "node --env-file-if-exists=../../.env scripts/migrate.mjs down"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "kysely": "0.29.6",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
