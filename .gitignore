# Dependencies (Composer and npm)
/backend/vendor/
/frontend/node_modules/
/node_modules/

# Build output
/frontend/dist/
/backend/public/build/
*.tsbuildinfo

# Secrets: never commit. Only the *.example templates are tracked.
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.pem
*.key
*.p12
*.pfx

# Laravel runtime data: uploaded candidate files, logs, sessions, caches
/backend/storage/*.key
/backend/storage/app/private/
/backend/storage/app/public/
/backend/storage/framework/cache/
/backend/storage/framework/sessions/
/backend/storage/framework/views/
/backend/storage/logs/
/backend/bootstrap/cache/*.php

# Local data: real candidate files and backups must never enter Git
backups/
uploads/
*.dump
*.backup
*.sql.gz

# Test output
/backend/coverage/
/tests/e2e/test-results/
/tests/e2e/playwright-report/
.phpunit.result.cache
*.log

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# NOTE: *.sql is NOT ignored on purpose. Any SQL file in the repository is reviewed code.