# Copy this file to .env and fill real values locally. Never commit .env.
NODE_ENV=development
APP_PORT=3000
APP_ORIGIN=http://localhost:5173

# Use a least-privilege app role in later phases (not the postgres superuser)
DATABASE_URL=postgres://smartthink_app:CHANGE_ME@localhost:5432/smartthink_dev

# Generate locally, minimum 32 random characters. Example: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# Private, non-public file storage. Keep outside the Git repo in production.
FILE_STORAGE_PATH=./storage